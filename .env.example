# ---------------------------------------------------------------------------
# TextileOps environment. Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://textileops:textileops@localhost:55433/textileops
# Used by pytest; created/dropped by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://textileops:textileops@localhost:55433/textileops_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=720
# Password given to the seeded demo accounts. Seeding refuses to run in production.
DEMO_PASSWORD=textileops

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AI provider -----------------------------------------------------------
# TextileOps runs fully without a key: the deterministic stub provider takes
# over and every AI-derived artefact is labelled as stubbed in the UI.
# AI_PROVIDER: auto | anthropic | stub
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Ingestion ---
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=20971520

# --- Workers ---
WORKER_POLL_SECONDS=1.0
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=3

# --- Business policy thresholds (tune per business) ---
ORDER_AT_RISK_BUFFER_DAYS=3
PO_LATE_GRACE_DAYS=0
SUPPLIER_DELAY_WARN_DAYS=2
SHIPMENT_DELAY_GRACE_DAYS=1

# --- Demo ---
ENABLE_SIMULATION=true
# A hosted demonstration on fictional data: one-click owner sign-in, daily
# reload, simulation allowed in production. Refuses to run with PILOT_MODE.
DEMO_MODE=false

# --- Pilot ---
# First contact with a real business: TextileOps ingests, calculates and
# proposes, but changes nothing by itself. Refuses to run with DEMO_MODE.
PILOT_MODE=false

# --- Frontend (apps/web) ---
# Local development: the browser calls the API directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Deployed: leave NEXT_PUBLIC_API_BASE_URL unset; the web server proxies
# /api/v1 to API_ORIGIN (a URL) or API_HOSTPORT (private host:port) at runtime.
# API_ORIGIN=http://api:8000
