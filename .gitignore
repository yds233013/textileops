# Secrets — never commit
.env
.env.*
!.env.example
# ...and the per-app templates, which the blanket .env.* rule above
# would otherwise swallow. These hold no secret, only variable names.
!.env.local.example
!*.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/
coverage/

# Runtime
var/
uploads/
*.log

# OS / editors
.DS_Store
.idea/
.vscode/
